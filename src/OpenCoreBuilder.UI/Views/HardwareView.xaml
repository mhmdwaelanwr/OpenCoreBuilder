<UserControl x:Class="OpenCoreBuilder.UI.Views.HardwareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <StackPanel>
            <TextBlock Text="Hardware Profile"
                    FontSize="20"
                    FontWeight="Bold"
                    Margin="0,0,0,20"/>

            <Button Content="Detect Hardware"
                    Command="{Binding DetectHardwareCommand}"
                    HorizontalAlignment="Left"
                    Width="150"/>

            <TextBlock Text="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Foreground="Blue"
                    Margin="0,10"/>

            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                        Grid.Column="0"
                        Text="CPU:"
                        FontWeight="Bold"
                        Margin="0,5"/>
                <TextBlock Grid.Row="0"
                        Grid.Column="1"
                        Text="{Binding Profile.CPUName}"
                        Margin="10,5"/>

                <TextBlock Grid.Row="1"
                        Grid.Column="0"
                        Text="Architecture:"
                        FontWeight="Bold"
                        Margin="0,5"/>
                <TextBlock Grid.Row="1"
                        Grid.Column="1"
                        Text="{Binding Profile.CPUArchitecture}"
                        Margin="10,5"/>

                <TextBlock Grid.Row="2"
                        Grid.Column="0"
                        Text="GPU:"
                        FontWeight="Bold"
                        Margin="0,5"/>
                <TextBlock Grid.Row="2"
                        Grid.Column="1"
                        Text="{Binding Profile.GPUName}"
                        Margin="10,5"/>

                <TextBlock Grid.Row="3"
                        Grid.Column="0"
                        Text="Motherboard:"
                        FontWeight="Bold"
                        Margin="0,5"/>
                <TextBlock Grid.Row="3"
                        Grid.Column="1"
                        Text="{Binding Profile.MotherboardModel}"
                        Margin="10,5"/>

                <TextBlock Grid.Row="4"
                        Grid.Column="0"
                        Text="RAM (MB):"
                        FontWeight="Bold"
                        Margin="0,5"/>
                <TextBlock Grid.Row="4"
                        Grid.Column="1"
                        Text="{Binding Profile.RAMSizeMB}"
                        Margin="10,5"/>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
