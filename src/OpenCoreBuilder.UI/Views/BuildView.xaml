<UserControl x:Class="OpenCoreBuilder.UI.Views.BuildView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <StackPanel>
            <TextBlock Text="Build EFI"
                    FontSize="20"
                    FontWeight="Bold"
                    Margin="0,0,0,20"/>

            <Button Content="Generate EFI"
                    Command="{Binding BuildEFICommand}"
                    HorizontalAlignment="Left"
                    Width="150"
                    IsEnabled="{Binding IsBuilding, Converter={StaticResource InverseBooleanConverter}}"/>

            <TextBlock Text="{Binding StatusMessage}"
                    Margin="0,20"
                    FontSize="16"
                    TextWrapping="Wrap"/>

            <ProgressBar IsIndeterminate="True"
                    Height="20"
                    Visibility="{Binding IsBuilding, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Margin="0,10"/>
        </StackPanel>
    </Grid>
</UserControl>
