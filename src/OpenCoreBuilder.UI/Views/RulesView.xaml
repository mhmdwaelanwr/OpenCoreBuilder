<UserControl x:Class="OpenCoreBuilder.UI.Views.RulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Validation Rules"
                    FontSize="20"
                    FontWeight="Bold"
                    Margin="0,0,0,20"/>
            <Button Content="Run Validation"
                    Command="{Binding RunValidationCommand}"
                    HorizontalAlignment="Left"
                    Width="150"/>
        </StackPanel>

        <ListView Grid.Row="1"
                ItemsSource="{Binding ValidationResults}"
                Margin="0,20,0,0">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Severity"
                            DisplayMemberBinding="{Binding Severity}"
                            Width="100"/>
                    <GridViewColumn Header="Message"
                            DisplayMemberBinding="{Binding Message}"
                            Width="400"/>
                    <GridViewColumn Header="Recommendation"
                            DisplayMemberBinding="{Binding Recommendation}"
                            Width="300"/>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</UserControl>
