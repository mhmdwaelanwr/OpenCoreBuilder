<Window x:Class="OpenCoreBuilder.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:OpenCoreBuilder.UI.ViewModels"
        xmlns:views="clr-namespace:OpenCoreBuilder.UI.Views"
        mc:Ignorable="d"
        Title="OpenCore Builder"
        Height="600"
        Width="900"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HardwareViewModel}">
            <views:HardwareView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RulesViewModel}">
            <views:RulesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BuildViewModel}">
            <views:BuildView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AboutViewModel}">
            <views:AboutView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0"
                Background="#2D2D30"
                Padding="10">
            <StackPanel>
                <TextBlock Text="OC Builder"
                        Foreground="White"
                        FontSize="20"
                        FontWeight="Bold"
                        Margin="0,0,0,20"
                        HorizontalAlignment="Center"/>

                <Button Content="Dashboard"
                        Command="{Binding NavigateToDashboardCommand}"
                        Margin="0,5"/>
                <Button Content="Hardware"
                        Command="{Binding NavigateToHardwareCommand}"
                        Margin="0,5"/>
                <Button Content="Rules"
                        Command="{Binding NavigateToRulesCommand}"
                        Margin="0,5"/>
                <Button Content="Build"
                        Command="{Binding NavigateToBuildCommand}"
                        Margin="0,5"/>
                <Button Content="Settings"
                        Command="{Binding NavigateToSettingsCommand}"
                        Margin="0,5"/>
                <Button Content="About"
                        Command="{Binding NavigateToAboutCommand}"
                        Margin="0,5"/>

                <TextBlock Text="Integrations"
                        Foreground="Gray"
                        FontSize="14"
                        Margin="0,20,0,5"
                        HorizontalAlignment="Center"/>
                <Button Content="Open Repo"
                        Command="{Binding OpenRepoCommand}"
                        Margin="0,5"/>
                <Button Content="ProperTree"
                        Command="{Binding LaunchProperTreeCommand}"
                        Margin="0,5"/>
            </StackPanel>
        </Border>

        <!-- Content Area -->
        <ContentControl Grid.Column="1"
                Content="{Binding NavigationService.CurrentView}"
                Margin="20"/>
    </Grid>
</Window>
